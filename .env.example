# The service runs fully without any secrets using a deterministic,
# catalogue-grounded fallback. Set an OpenAI-compatible key to enable an
# LLM-authored reply + candidate re-ranking.

# --- Optional LLM (OpenAI-compatible chat completions) ---
# One key is enough. The simplest is OPENAI_API_KEY (see shortcuts below).
# Generic form (pair with a base URL + model):
# SHL_LLM_API_KEY=
# SHL_LLM_BASE_URL=https://api.openai.com/v1
# SHL_LLM_MODEL=gpt-4o-mini
# SHL_LLM_TIMEOUT=20

# Provider shortcuts (base URL + model are inferred automatically):
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# --- Retrieval / catalog ---
# SHL_USE_EMBEDDINGS=1        # requires sentence-transformers (+ numpy)
# SHL_CATALOG=catalog.json    # override catalog path

# --- Server ---
# PORT=8000
